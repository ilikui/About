    font-size clamp(2.7rem, 6.2vw, 4.4rem)
    font-weight 780
    line-height 1.08
    letter-spacing -.075em
    span
      color var(--home-green)

  .home-lead
    max-width 34rem
    margin 0
    color #606b61
    font-size .94rem
    line-height 2
    text-align left

  .home-actions
    display flex
    flex-wrap wrap
    gap .65rem
    margin-top 1.65rem

  .home-button
    display inline-flex
    align-items center
    gap .9rem
    padding .72rem .95rem
    border 1px solid #d7ded5
    border-radius 3px
    background rgba(255,255,255,.65)
    color #354338
    font-size .78rem
    font-weight 650
