$base-style
    h1,
    .h1
        letter-spacing: 0.01em
        font-size: 1.5em
        font-style: normal
        font-weight: 700
        color: $color-accent
        margin-top: 3rem
        margin-bottom: 1rem
        display: block
        antialias()
    h2,
    .h2
        position: relative
        font-size: 1rem
        font-weight: bold
        text-transform: none
        letter-spacing: normal
        margin-top: 2rem
        margin-bottom: 0.5rem
        color: $color-lightest
        display: block
    h3
        font-size: 0.9rem
        font-weight: bold
        text-decoration: underline;
        color: $color-lightest
    h4,
    h5,
    h6
        font-size: 0.9rem
        font-weight: normal
        color: $color-light
        border-bottom: 1px dashed $color-light
        display: inline
        text-decoration: none
    h3,
    h4,
    h5,
    h6
        margin-top: 0.9rem
        margin-bottom: 0.5rem
    hr
        border: 1px dashed $color-light
    strong
        font-weight: bold
    em, cite
        font-style: italic
    sup, sub
        font-size: 0.75em
        line-height: 0
        position: relative
        vertical-align: baseline
    sup
        top: -0.5em
    sub
        bottom: -0.2em
    small
        font-size: 0.85em
    acronym, abbr
        border-bottom: 1px dotted
    ul, ol, dl
        line-height: $line-height
    ul, ol
        ul, ol
            margin-top: 0
            margin-bottom: 0
    ol
        list-style: decimal
    dt
        font-weight: bold
    table
        width: 100%
        font-size: $font-size - 2px
        border-collapse: collapse
        text-align: left
    th
        font-size: $font-size - 1px
        font-weight: bold
        color: $color-lightest
        border-bottom: 1px dashed #ccc
        padding: 8px 8px
    td
        border-bottom: none 
        padding: 9px 8px 0px 8px


// Homepage: calm editorial layout with clear hierarchy and responsive cards.
.home-page
  color #202820
  font-family -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif

  .home-hero
    position relative
    overflow hidden
    margin 2.5rem 0 3.5rem
    padding 3.25rem 3rem 2.5rem
    border 1px solid #e5e9e3
    border-radius 22px
    background linear-gradient(135deg, #f7faf6 0%, #eef4ed 100%)

  .home-eyebrow, .home-kicker
    margin 0
    color #2d6a4f
    font-size .68rem
    font-weight 750
    letter-spacing .16em
    text-align left

  .home-hero h1
    margin 1rem 0 .85rem
    color #202820
    font-size clamp(2.1rem, 5vw, 3.25rem)
    font-weight 760
    letter-spacing -.055em
    line-height 1.18

  .home-lead
    max-width 36rem
    margin 0
    color #5e6a60
    font-size 1rem
    line-height 1.95
    text-align left

  .home-actions
    display flex
    flex-wrap wrap
    gap .7rem
    margin-top 1.5rem

  .home-button
    display inline-flex
    align-items center
    gap .8rem
    padding .72rem 1rem
    border 1px solid #d8e0d7
    border-radius 9px
    background rgba(255,255,255,.76)
    color #26372b
    font-size .82rem
    font-weight 650
    text-decoration none
    transition transform .18s ease, border-color .18s ease, background .18s ease
    &:hover
      transform translateY(-2px)
      border-color #9bb6a1
      background #fff

  .home-button-primary
    border-color #2d6a4f
    background #2d6a4f
    color #fff
    &:hover
      border-color #24553f
      background #24553f
      color #fff

  .home-topics
    display flex
    flex-wrap wrap
    gap .5rem
    margin-top 2rem
    span
      padding .35rem .65rem
      border 1px solid #dfe7dc
      border-radius 999px
      color #647067
      background rgba(255,255,255,.56)
      font-size .72rem

  .home-section
    margin 0 0 3.25rem

  .home-section-heading
    display flex
    align-items end
    justify-content space-between
    gap 1rem
    margin-bottom 1.15rem
    h2
      margin .35rem 0 0
      color #202820
      font-size 1.4rem
      font-weight 750
      letter-spacing -.035em
    > p
      margin 0 0 .15rem
      color #6d756e
      font-size .8rem
      text-align right

  .home-entry-grid
    display grid
    grid-template-columns repeat(3, minmax(0, 1fr))
    gap .85rem

  .home-entry
    position relative
    display flex
    min-height 205px
    flex-direction column
    padding 1.15rem
    border 1px solid #e5e9e3
    border-radius 14px
    background #fff
    text-decoration none
    transition transform .2s ease, box-shadow .2s ease, border-color .2s ease
    &:hover
      transform translateY(-3px)
      border-color #c8d7ca
      box-shadow 0 12px 28px rgba(34, 55, 39, .07)
      background #fff
    h3
      margin 1.4rem 0 .45rem
      color #26352a
      font-size 1rem
      font-weight 750
      text-decoration none
    p
      margin 0
      color #6d756e
      font-size .8rem
      line-height 1.8
      text-align left
    .home-entry-number
      color #8a958b
      font-size .63rem
      font-weight 700
      letter-spacing .12em
    .home-entry-icon
      position absolute
      top 1rem
      right 1rem
      display grid
      width 30px
      height 30px
      place-items center
      border-radius 8px
      background #f1f6f0
      color #2d6a4f
      font-size 1rem
    .home-entry-link
      margin-top auto
      padding-top 1.1rem
      color #2d6a4f
      font-size .75rem
      font-weight 700

  .home-more
    color #2d6a4f
    font-size .78rem
    font-weight 700
    text-decoration none
    &:hover
      color #1f4c38

  .home-post-list
    margin 0
    padding 0
    border-top 1px solid #e5e9e3
    list-style none

  .home-post-item
    display grid
    grid-template-columns 6.5rem minmax(0, 1fr) 1rem
    align-items center
    gap .8rem
    margin 0
    padding .95rem .15rem
    border-bottom 1px solid #e5e9e3
    .home-post-date
      color #899189
      font-size .72rem
      font-variant-numeric tabular-nums
    > a
      overflow hidden
      color #303b32
      font-size .88rem
      font-weight 600
      text-overflow ellipsis
      white-space nowrap
      text-decoration none
      &:hover
        color #2d6a4f
        background none
    .home-post-arrow
      color #9ba59b
      font-size .85rem

  .home-note
    display flex
    align-items flex-start
    gap 1rem
    margin 0 0 2rem
    padding 1.3rem 1.4rem
    border 1px solid #e5e9e3
    border-radius 14px
    background #fafbf9
    .home-note-mark
      display grid
      flex 0 0 34px
      width 34px
      height 34px
      place-items center
      border-radius 10px
      background #e9f1e8
      color #2d6a4f
      font-size 1.1rem
    .home-note-text
      margin .35rem 0 0
      color #2e3b30
      font-size 1rem
      font-weight 700
      text-align left
      span
        display block
        margin-top .35rem
        color #6d756e
        font-size .78rem
        font-weight 400

@media (min-width: 540px)
  .content.width
    max-width 54rem

@media (max-width: 700px)
  .home-page
    .home-hero
      margin-top 1.5rem
      padding 2rem 1.35rem 1.5rem
      border-radius 16px
    .home-entry-grid
      grid-template-columns 1fr
    .home-entry
      min-height 170px
    .home-section-heading
      align-items flex-start
      flex-direction column
      > p
        text-align left
    .home-post-item
      grid-template-columns 5.4rem minmax(0, 1fr) .75rem
      gap .55rem
      padding .85rem 0
      .home-post-date
        font-size .66rem
      > a
        font-size .8rem
    .home-note
      padding 1rem


// About page: readable profile sections and responsive focus cards.
.about-focus-grid
  display grid
  grid-template-columns repeat(3, minmax(0, 1fr))
  gap .85rem
  margin 1.25rem 0 2rem

  .about-focus-card
    padding 1.1rem
    border 1px solid #e5e9e3
    border-radius 12px
    background #fafbf9

    h3
      margin .2rem 0 .6rem
      color #26352a
      font-size 1rem
      text-decoration none

    p
      margin 0
      color #667067
      font-size .88rem
      line-height 1.85
      text-align left

@media (max-width: 700px)
  .about-focus-grid
    grid-template-columns 1fr


// ─────────────────────────────────────────────────────────────
// About redesign · editorial knowledge garden
// ─────────────────────────────────────────────────────────────
.home-page
  --home-ink #202720
  --home-muted #69736a
  --home-line #e4e8e1
  --home-green #315f48
  --home-paper #fbfcf9
  color var(--home-ink)
  font-family -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif

  .home-hero
    display grid
    grid-template-columns minmax(0, 1.45fr) minmax(220px, .7fr)
    gap 2rem
    min-height 350px
    margin 2.2rem 0 4.5rem
    padding 3.2rem
    overflow hidden
    position relative
    border 1px solid #e2e7df
    border-radius 4px
    background radial-gradient(ellipse at 88% 15%, rgba(213, 228, 210, .65), transparent 42%), linear-gradient(135deg, #fafbf8 0%, #f1f5ef 100%)

  .home-eyebrow, .home-kicker
    margin 0
    color var(--home-green)
    font-size .66rem
    font-weight 750
    letter-spacing .15em
    text-align left

  .home-status-dot
    display inline-block
    width 7px
    height 7px
    margin-right .45rem
    border-radius 50%
    background #6d9878
    box-shadow 0 0 0 3px rgba(109,152,120,.12)

  .home-hero h1
    margin 1.2rem 0 1rem
    color var(--home-ink)
    font-size clamp(2.7rem, 6.2vw, 4.4rem)
    font-weight 780
    line-height 1.08
    letter-spacing -.075em
    span
      color var(--home-green)

  .home-lead
    max-width 34rem
    margin 0
    color #606b61
    font-size .94rem
    line-height 2
    text-align left

  .home-actions
    display flex
    flex-wrap wrap
    gap .65rem
    margin-top 1.65rem

  .home-button
    display inline-flex
    align-items center
    gap .9rem
    padding .72rem .95rem
    border 1px solid #d7ded5
    border-radius 3px
    background rgba(255,255,255,.65)
    color #354338
    font-size .78rem
    font-weight 650
    text-decoration none
    transition all .18s ease
    &:hover
      transform translateY(-2px)
      border-color #9fb4a1
      background #fff
      color #294e38

  .home-button-primary
    border-color var(--home-green)
    background var(--home-green)
    color #fff
    &:hover
      border-color #234832
      background #234832
      color #fff

  .home-hero-aside
    display flex
    flex-direction column
    align-items flex-start
    justify-content space-between
    min-height 245px
    padding 1.15rem 0 0 1.6rem
    border-left 1px solid rgba(49,95,72,.18)
    .home-aside-index, .home-aside-foot
      color #778378
      font-size .61rem
      font-weight 700
      letter-spacing .13em
    > p
      margin 0
      color #3a4d3e
      font-family Georgia, "Times New Roman", serif
      font-size clamp(1.25rem, 2.3vw, 1.7rem)
      line-height 1.55
      text-align left
      em
        color var(--home-green)
        font-style italic

  .home-orbit
    position relative
    display grid
    width 112px
    height 112px
    place-items center
    border 1px solid rgba(49,95,72,.28)
    border-radius 50%
    &::before
      position absolute
      width 76px
      height 76px
      border 1px solid rgba(49,95,72,.25)
      border-radius 50%
      content ""
    &::after
      position absolute
      width 40px
      height 40px
      border-radius 50%
      background #dce8d8
      content ""
    span
      z-index 1
      width 13px
      height 13px
      border-radius 50%
      background var(--home-green)
    i
      position absolute
      z-index 2
      top 13px
      right 19px
      width 7px
      height 7px
      border-radius 50%
      background #91ad91
    b
      position absolute
      bottom 13px
      left 16px
      width 5px
      height 5px
      border-radius 50%
      background #b0c4a9

  .home-section
    margin 0 0 4.2rem

  .home-section-heading
    display flex
    align-items end
    justify-content space-between
    gap 1rem
    margin-bottom 1.25rem
    h2
      margin .45rem 0 0
      color var(--home-ink)
      font-size 1.45rem
      font-weight 760
      letter-spacing -.045em
    > p
      margin 0 0 .2rem
      color #7a837a
      font-size .76rem
      text-align right

  .home-heading-period
    color #9ba49a
    font-size .68rem
    font-weight 500
    letter-spacing .03em

  .home-entry-grid
    display grid
    grid-template-columns repeat(3, minmax(0, 1fr))
    gap .8rem

  .home-entry
    display flex
    flex-direction column
    min-height 225px
    padding 1.25rem
    border 1px solid var(--home-line)
    border-radius 4px
    background #fff
    text-decoration none
    transition transform .2s ease, border-color .2s ease, box-shadow .2s ease
    &:hover
      transform translateY(-3px)
      border-color #c6d5c7
      box-shadow 0 14px 30px rgba(34,55,39,.06)
      background #fff
    .home-entry-number
      color #899489
      font-size .61rem
      font-weight 750
      letter-spacing .12em
    .home-entry-symbol
      display grid
      width 35px
      height 35px
      margin-top 1.4rem
      place-items center
      background #f0f5ef
      color var(--home-green)
      font-size 1.05rem
    h3
      margin .85rem 0 .5rem
      color #28372c
      font-size 1rem
      font-weight 750
      text-decoration none
    p
      margin 0
      color #6b756c
      font-size .78rem
      line-height 1.85
      text-align left
    .home-entry-link
      display flex
      justify-content space-between
      margin-top auto
      padding-top 1.25rem
      color var(--home-green)
      font-size .72rem
      font-weight 700
      b
        font-weight 500

  .home-more
    color var(--home-green)
    font-size .75rem
    font-weight 700
    text-decoration none
    &:hover
      color #1f4932

  .home-post-list
    margin 0
    padding 0
    border-top 1px solid var(--home-line)
    list-style none

  .home-post-item
    display grid
    grid-template-columns 6.2rem minmax(0, 1fr) 1rem
    align-items center
    gap .8rem
    margin 0
    padding 1rem .15rem
    border-bottom 1px solid var(--home-line)
    .home-post-date
      color #899389
      font-size .7rem
      font-variant-numeric tabular-nums
    > a
      overflow hidden
      color #354036
      font-size .85rem
      font-weight 600
      text-overflow ellipsis
      white-space nowrap
      text-decoration none
      &:hover
        color var(--home-green)
        background none
    .home-post-arrow
      color #98a198
      font-size .85rem

  .home-post-empty
    padding 1.2rem .15rem
    color #7a837a
    font-size .82rem

  .home-bottom-grid
    display grid
    grid-template-columns 1fr 1fr
    gap .8rem
    margin-bottom 2rem

  .home-resource
    position relative
    display flex
    flex-direction column
    align-items flex-start
    padding 1.3rem
    border 1px solid var(--home-line)
    background var(--home-paper)
    text-decoration none
    transition border-color .18s ease
    &:hover
      border-color #b7cbb9
      background #f6f9f4
    .home-resource-label
      color #7c897d
      font-size .6rem
      font-weight 750
      letter-spacing .14em
    strong
      margin .7rem 0 .35rem
      color #2d3b30
      font-size .95rem
    span:not(.home-resource-label)
      max-width 20rem
      color #707a70
      font-size .76rem
      line-height 1.8
    > b
      position absolute
      top 1.2rem
      right 1.2rem
      color var(--home-green)
      font-weight 500

  .home-manifesto
    grid-column 1 / -1
    display grid
    grid-template-columns 2.5rem 1fr
    column-gap .6rem
    align-items center
    padding 1.35rem 1.5rem
    border-left 2px solid #9bb49a
    background #f7f9f5
    .home-manifesto-mark
      grid-row span 2
      align-self start
      color #9bb49a
      font-family Georgia, serif
      font-size 3rem
      line-height 1
    p
      margin 0
      color #304334
      font-size 1rem
      font-weight 750
      text-align left
    > span:last-child
      margin-top .35rem
      color #7a837a
      font-size .75rem

@media (min-width: 540px)
  .content.width
    max-width 60rem

@media (max-width: 760px)
  .home-page
    .home-hero
      grid-template-columns 1fr
      gap 2rem
      min-height 0
      margin 1.4rem 0 3.3rem
      padding 2rem 1.35rem
    .home-hero h1
      font-size clamp(2.7rem, 12vw, 3.7rem)
    .home-hero-aside
      display grid
      grid-template-columns 1fr auto
      align-items center
      gap .7rem
      min-height 0
      padding 1rem 0 0
      border-top 1px solid rgba(49,95,72,.18)
      border-left 0
      .home-aside-index
        grid-column 1 / -1
      > p
        font-size 1.15rem
    .home-orbit
      grid-column 2
      grid-row 2 / span 2
      width 82px
      height 82px
      &::before
        width 56px
        height 56px
      &::after
        width 30px
        height 30px
    .home-section
      margin-bottom 3.2rem
    .home-section-heading
      align-items flex-start
      flex-direction column
      > p
        text-align left
    .home-entry-grid
      grid-template-columns 1fr
    .home-entry
      min-height 0
    .home-entry-link
      padding-top 1rem
    .home-bottom-grid
      grid-template-columns 1fr
    .home-manifesto
      grid-column auto
    .home-post-item
      grid-template-columns 5rem minmax(0, 1fr) .7rem
      gap .5rem
      padding .85rem 0
      .home-post-date
        font-size .64rem
      > a
        font-size .78rem
