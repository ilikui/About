.home-page
  --home-ink: #202720
  --home-muted: #69736a
  --home-line: #e4e8e1
  --home-green: #315f48
  --home-paper: #fbfcf9
  color var(--home-ink)
  font-family -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif

  .home-hero
