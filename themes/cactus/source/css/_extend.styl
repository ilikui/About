// -----------------------------------------------------------------------------
// Site-wide design system — editorial knowledge garden
// -----------------------------------------------------------------------------
:root
  color-scheme light

html
  border-top 3px solid #315f49
  scroll-behavior smooth

body
  background #f7f7f3
  color #26332b
  font-family -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif
  font-size 15px
  line-height 1.8
  letter-spacing .005em

.content.index.width.mx-auto.px2.my4
  width calc(100% - 3rem)
  max-width 1120px
  margin 0 auto
  padding 0
  flex 1

#header
  display flex
  align-items center
  justify-content space-between
  gap 2rem
  width 100%
  max-width none
  margin 0 auto
  padding 1.45rem 0 1.2rem
  border-bottom 1px solid #e4e7df

#header > a
  display flex
  align-items center
  gap .8rem
  min-width 0

#header #logo
  display grid
  float none
  flex 0 0 42px
  width 42px
  height 42px
  margin 0
  place-items center
  border-radius 13px
  background #315f49
  filter none
  -webkit-filter none

#header #logo:after
  content "K"
  color #fff
  font-size 20px
  font-weight 800
  letter-spacing -.06em

#header #title h1
  margin 0
  color #24352b
  font-size 1rem
  font-weight 760
  letter-spacing -.025em
  line-height 1.35

#header #title:after
  content "PERSONAL KNOWLEDGE GARDEN"
  display block
  margin-top .18rem
  color #8b948b
  font-size .57rem
  font-weight 700
  letter-spacing .12em
  line-height 1.4

#header #nav
  color #526257
  font-size .78rem
  font-weight 650
  letter-spacing 0

#header #nav ul
  display flex
  align-items center
  gap .2rem

#header #nav ul li
  margin 0
  padding 0
  border 0

#header #nav ul a
  display inline-flex
  align-items center
  margin 0
  padding .55rem .8rem
  border-radius 8px
  color #5f6b61
  transition background .18s ease, color .18s ease

#header #nav ul a:hover
  color #234f3a
  background #eaf0e8
  text-decoration none

#header #nav .icon
  display none

.home-page
  padding-bottom 1rem

.home-hero
  display grid
  grid-template-columns minmax(0, 1.55fr) minmax(230px, .8fr)
  align-items center
  gap 2rem
  min-height 360px
  margin 2.2rem 0 4rem
  padding 3.2rem 3.4rem
  border-color #e3e8df
  border-radius 24px
  background radial-gradient(circle at 85% 15%, rgba(203, 222, 200, .55), transparent 34%), linear-gradient(135deg, #f0f5ee 0%, #fbfcf8 72%)
  box-shadow 0 18px 50px rgba(34, 54, 39, .035)

.home-hero-copy
  position relative
  z-index 1

.home-status-dot
  display inline-block
  width 7px
  height 7px
  margin-right .45rem
  border-radius 50%
  background #4e8b61
  box-shadow 0 0 0 4px rgba(78, 139, 97, .12)

.home-hero-aside
  position relative
  display flex
  min-height 245px
  flex-direction column
  align-items flex-start
  justify-content space-between
  overflow hidden
  padding 1.2rem 1.3rem
  border 1px solid rgba(198, 213, 197, .8)
  border-radius 18px
  background rgba(255, 255, 255, .58)

.home-aside-index, .home-aside-foot
  color #879388
  font-size .58rem
  font-weight 750
  letter-spacing .13em

.home-orbit
  position absolute
  top 50%
  right 1.25rem
  width 145px
  height 145px
  transform translateY(-50%)
  border 1px solid rgba(49, 95, 73, .22)
  border-radius 50%

.home-orbit:before, .home-orbit:after
  position absolute
  inset 17px
  border 1px solid rgba(49, 95, 73, .18)
  border-radius 50%
  content ""

.home-orbit:after
  inset 36px

.home-orbit span
  position absolute
  top 13px
  left 45px
  width 10px
  height 10px
  border-radius 50%
  background #315f49
  box-shadow 0 0 0 7px rgba(49, 95, 73, .1)

.home-orbit i
  position absolute
  right 17px
  bottom 29px
  width 7px
  height 7px
  border-radius 50%
  background #b9a57b

.home-orbit b
  position absolute
  top 57px
  left 17px
  width 5px
  height 5px
  border-radius 50%
  background #8baf8a

.home-hero-aside > p
  position relative
  z-index 1
  margin auto 0
  color #34483a
