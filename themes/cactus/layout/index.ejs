<div class="home-page">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero-copy">
      <p class="home-eyebrow"><span class="home-status-dot"></span> PERSONAL KNOWLEDGE GARDEN</p>
      <h1 id="home-title">你好，<br><span>我是 Kui。</span></h1>
      <p class="home-lead">工程师的好奇心，阅读者的耐心，创作者的行动力。<br>在技术、知识与日常生活之间，持续探索值得理解的问题。</p>
      <div class="home-actions">
        <a class="home-button home-button-primary" href="<%- url_for('archives') %>">探索文章 <span aria-hidden="true">↗</span></a>
        <a class="home-button" href="https://github.com/ilikui" target="_blank" rel="noopener noreferrer">开源项目 <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="home-hero-aside" aria-label="个人理念">
      <span class="home-aside-index">FIELD NOTES / 001</span>
      <div class="home-orbit" aria-hidden="true"><span></span><i></i><b></b></div>
      <p>Learn deeply.<br>Build thoughtfully.<br><em>Keep growing.</em></p>
      <span class="home-aside-foot">技术 · 知识 · 创造</span>
    </div>
  </section>

  <section class="home-section" aria-labelledby="home-focus-title">
    <div class="home-section-heading">
      <div><p class="home-kicker">AREAS OF INTEREST</p><h2 id="home-focus-title">关注的方向<span class="home-heading-period"> / 01—03</span></h2></div>
      <p>从理解原理，到建立连接，再到创造作品。</p>
    </div>
    <div class="home-entry-grid">
      <a class="home-entry home-entry-tech" href="https://github.com/ilikui/AutomaticDriving" target="_blank" rel="noopener noreferrer">
        <span class="home-entry-number">01 — ENGINEERING</span><span class="home-entry-symbol" aria-hidden="true">⌘</span>
        <h3>技术与工程</h3><p>嵌入式系统、汽车电子、自动驾驶与软件工程。让抽象原理落到可验证的实现。</p>
        <span class="home-entry-link">探索技术项目 <b aria-hidden="true">↗</b></span>
      </a>
      <a class="home-entry home-entry-knowledge" href="https://wiki.likui.info/" target="_blank" rel="noopener noreferrer">
        <span class="home-entry-number">02 — KNOWLEDGE</span><span class="home-entry-symbol" aria-hidden="true">⌁</span>
        <h3>知识与阅读</h3><p>卡片笔记、主题研究与阅读记录。把零散信息组织成可检索、可复用的知识网络。</p>
        <span class="home-entry-link">进入知识花园 <b aria-hidden="true">↗</b></span>
      </a>
      <a class="home-entry home-entry-creation" href="<%- url_for('archives') %>">
        <span class="home-entry-number">03 — CREATION</span><span class="home-entry-symbol" aria-hidden="true">✳</span>
        <h3>创作与实践</h3><p>用文章梳理思路，用代码验证想法，用持续迭代把学习变成真正的作品。</p>
        <span class="home-entry-link">阅读近期记录 <b aria-hidden="true">↗</b></span>
      </a>
    </div>
  </section>

  <section class="home-section home-writing" aria-labelledby="home-writing-title">
    <div class="home-section-heading">
      <div><p class="home-kicker">RECENT FIELD NOTES</p><h2 id="home-writing-title">最近的记录<span class="home-heading-period"> / NOTES</span></h2></div>
      <a class="home-more" href="<%- url_for('archives') %>">查看全部文章 <span aria-hidden="true">↗</span></a>
    </div>
    <ul class="home-post-list">
      <% var home_posts = site.posts.sort('date', 'desc').limit(6); %>
      <% home_posts.each(function(post){ %>
        <li class="home-post-item">
          <span class="home-post-date"><%- date(post.date, 'YYYY.MM.DD') %></span>
          <a href="<%- url_for(post.path) %>"><%= post.title %></a>
          <span class="home-post-arrow" aria-hidden="true">↗</span>
        </li>
      <% }); %>
      <% if (home_posts.length === 0) { %>
        <li class="home-post-empty">新的记录正在整理中。欢迎先从知识库与开源项目开始探索。</li>
      <% } %>
    </ul>
  </section>

  <section class="home-bottom-grid" aria-label="站点入口与理念">
    <a class="home-resource" href="https://github.com/ilikui" target="_blank" rel="noopener noreferrer">
      <span class="home-resource-label">OPEN SOURCE</span><strong>代码与作品</strong><span>在 GitHub 查看正在构建的项目与学习仓库。</span><b aria-hidden="true">↗</b>
    </a>
    <a class="home-resource" href="https://wiki.likui.info/" target="_blank" rel="noopener noreferrer">
      <span class="home-resource-label">PERSONAL WIKI</span><strong>个人知识库</strong><span>沿着主题、笔记和关联问题继续探索。</span><b aria-hidden="true">↗</b>
    </a>
    <div class="home-manifesto">
      <span class="home-manifesto-mark" aria-hidden="true">“</span>
      <p>持续积累，持续创造。</p>
      <span>让每一次记录，都成为下一次思考的起点。</span>
    </div>
  </section>
</div>
