<footer id="footer">
  <div class="footer-left">
    <span>© <%= new Date().getFullYear() %> <%= config.author || config.title %></span>
    <span class="footer-note">Built with curiosity · Powered by Hexo</span>
  </div>
  <div class="footer-right">
    <nav aria-label="页脚导航">
      <ul>
        <% for (var i in theme.nav) { %>
          <li><a href="<%- /^https?:\/\//.test(theme.nav[i]) ? theme.nav[i] : url_for(theme.nav[i]) %>"<%- /^https?:\/\//.test(theme.nav[i]) ? ' target="_blank" rel="noopener noreferrer"' : '' %>><%= i %></a></li>
        <% } %>
      </ul>
    </nav>
  </div>
</footer>
