<header id="header">
  <a class="site-brand" href="<%- url_for('/') %>" aria-label="<%= config.title %> 首页">
    <div id="logo" aria-hidden="true"></div>
    <div id="title">
      <h1><%= config.title %></h1>
    </div>
  </a>
  <nav id="nav" aria-label="主导航">
    <ul>
      <li class="icon">
        <a href="#" aria-label="打开导航菜单"><i class="fa fa-bars fa-lg" aria-hidden="true"></i></a>
      </li>
      <% for (var i in theme.nav) { %>
        <li><a href="<%- /^https?:\/\//.test(theme.nav[i]) ? theme.nav[i] : url_for(theme.nav[i]) %>"<%- /^https?:\/\//.test(theme.nav[i]) ? ' target="_blank" rel="noopener noreferrer"' : '' %>><%= i %></a></li>
      <% } %>
    </ul>
  </nav>
</header>
